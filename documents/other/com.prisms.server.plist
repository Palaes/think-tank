<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.prisms.server</string>
	<key>ProgramArguments</key>
	<array>
		<string>node</string>
		<string>./server/prisms.js</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/path/to/think-tank-old</string>
	<key>StandardOutPath</key>
	<string>/path/to/think-tank-old/prisms-server.log</string>
	<key>StandardErrorPath</key>
	<string>/path/to/think-tank-old/prisms-server.log</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
</dict>
</plist>